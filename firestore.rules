rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfil público de cada persona
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update, delete: if false;
    }

    // Nombre de usuario -> uid (sirve para buscar destinatarios)
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Hilos: solo los ven y los modifican sus miembros
    match /threads/{tid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 21
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 120;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.memberInfo == resource.data.memberInfo;
      allow delete: if false;

      // Mensajes: no se pueden editar ni borrar
      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(tid)).data.members;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/threads/$(tid)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
    }
  }
}
